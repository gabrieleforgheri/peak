{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": { "@common/*": ["../common/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
